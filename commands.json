[
  {
    "pattern": [
      [
        "mission",
        "show windows",
        "overview"
      ]
    ],
    "action": {
      "type": "input.shortcut",
      "params": {
        "code": 126,
        "modifiers": [
          "ctrl"
        ]
      }
    },
    "category": "Windowing",
    "description": "Open Mission Control to see all windows."
  },
  {
    "pattern": [
      "next",
      "window"
    ],
    "action": {
      "type": "input.shortcut",
      "params": {
        "code": 50,
        "modifiers": [
          "cmd"
        ]
      }
    },
    "category": "Windowing",
    "description": "Cycle to the next window of the current app."
  },
  {
    "pattern": [
      "snap"
    ],
    "category": "Snap Mode",
    "sets_tags": [
      "plugin.placement.snap_mode"
    ],
    "description": "Enter snap mode — then say a direction to position the window."
  },
  {
    "pattern": [
      "left"
    ],
    "action": {
      "type": "placement.snap",
      "params": {
        "position": "left"
      }
    },
    "category": "Snap Mode",
    "requires_tags": [
      "plugin.placement.snap_mode"
    ],
    "sets_tags": [
      "plugin.placement.snap_mode"
    ],
    "description": "Snap the window to the left half (snap mode)."
  },
  {
    "pattern": [
      "right"
    ],
    "action": {
      "type": "placement.snap",
      "params": {
        "position": "right"
      }
    },
    "category": "Snap Mode",
    "requires_tags": [
      "plugin.placement.snap_mode"
    ],
    "sets_tags": [
      "plugin.placement.snap_mode"
    ],
    "description": "Snap the window to the right half (snap mode)."
  },
  {
    "pattern": [
      [
        "full",
        "maximize"
      ]
    ],
    "action": {
      "type": "placement.snap",
      "params": {
        "position": "maximize"
      }
    },
    "category": "Snap Mode",
    "requires_tags": [
      "plugin.placement.snap_mode"
    ],
    "sets_tags": [
      "plugin.placement.snap_mode"
    ],
    "description": "Maximize the window to fill the screen (snap mode)."
  },
  {
    "pattern": [
      "center"
    ],
    "action": {
      "type": "placement.snap",
      "params": {
        "position": "center"
      }
    },
    "category": "Snap Mode",
    "requires_tags": [
      "plugin.placement.snap_mode"
    ],
    "sets_tags": [
      "plugin.placement.snap_mode"
    ],
    "description": "Center the window on screen (snap mode)."
  },
  {
    "pattern": [
      "next"
    ],
    "action": {
      "type": "placement.snap",
      "params": {
        "position": "next"
      }
    },
    "category": "Snap Mode",
    "requires_tags": [
      "plugin.placement.snap_mode"
    ],
    "sets_tags": [
      "plugin.placement.snap_mode"
    ],
    "description": "Snap to the next position in the cycle (snap mode)."
  },
  {
    "pattern": [
      "previous"
    ],
    "action": {
      "type": "placement.snap",
      "params": {
        "position": "prev"
      }
    },
    "category": "Snap Mode",
    "requires_tags": [
      "plugin.placement.snap_mode"
    ],
    "sets_tags": [
      "plugin.placement.snap_mode"
    ],
    "description": "Snap to the previous position in the cycle (snap mode)."
  },
  {
    "pattern": [
      "blank",
      "window",
      "desk",
      "<number>"
    ],
    "action": {
      "type": "placement.move_to_space",
      "params": {
        "space": "{number}"
      }
    },
    "category": "Windowing",
    "description": "Move the current window to another desktop and follow it there."
  },
  {
    "pattern": [
      "stash",
      "window",
      "desk",
      "<number>"
    ],
    "action": {
      "type": "placement.move_to_space",
      "params": {
        "space": "{number}",
        "stay": true
      }
    },
    "category": "Windowing",
    "description": "Move the current window to another desktop but stay here."
  },
  {
    "pattern": [
      [
        "desk",
        "desktop"
      ]
    ],
    "category": "Desk Mode",
    "sets_tags": [
      "plugin.placement.desk_mode"
    ],
    "description": "Enter desk mode — then say a number to switch desktops."
  },
  {
    "pattern": [
      "<number>"
    ],
    "action": {
      "type": "placement.desk_switch",
      "params": {
        "space": "{number}"
      }
    },
    "category": "Desk Mode",
    "requires_tags": [
      "plugin.placement.desk_mode"
    ],
    "sets_tags": [
      "plugin.placement.desk_mode"
    ],
    "description": "Switch to the numbered desktop (desk mode)."
  }
]
