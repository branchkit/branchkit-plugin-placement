{
  "$schema": "https://branchkit.dev/schemas/manifest.json",
  "id": "windows",
  "name": "Windows",
  "icon": "grid",
  "requires": {
    "privileges": [
      "windows",
      "input",
      "display"
    ],
    "capabilities": {
      "uses": [
        "native.batch_set_frames",
        "native.cursor_info",
        "native.focused_window_id",
        "native.list_spaces",
        "native.switch_space",
        "native.warp_cursor",
        "native.window_bounds",
        "native.world_model"
      ]
    }
  },
  "version": "1.0.0",
  "min_api_version": "0.2.0",
  "description": "Native window management \u2014 snap, move to space, switch desktops. Uses built-in OS primitives without a tiling system.",
  "author": "BranchKit",
  "publisher": "github:branchkit",
  "dev": {
    "build": [
      ["templ", "generate"],
      ["go", "build", "-ldflags=-s -w", "-o", "../windows-plugin", "."]
    ],
    "build_dir": "src"
  },
  "run": "./windows-plugin",
  "collection_data": {
    "voice_commands": "commands.json"
  },
  "action_prefix": "windows",
  "action_types": {
    "desk_switch": { "uses": ["native.switch_space"],
      "label": "Switch Desktop",
      "consequence": "reversible",
      "fields": [
        {
          "key": "space",
          "label": "Space Number",
          "placeholder": "1",
          "field_type": "string",
          "required": true
        }
      ]
    },
    "snap": {
      "label": "Snap Window",
      "consequence": "reversible",
      "fields": [
        {
          "key": "position",
          "label": "Position",
          "field_type": "enum",
          "enum_values": ["left", "right", "maximize", "center", "next", "prev"],
          "required": false
        }
      ]
    },
    "move_to_space": { "uses": ["native.warp_cursor", "native.switch_space"],
      "label": "Move Window to Space",
      "fields": [
        {
          "key": "space",
          "label": "Space Number",
          "placeholder": "1",
          "field_type": "string",
          "required": true
        },
        {
          "key": "stay",
          "label": "Stay on Current Space",
          "field_type": "boolean",
          "required": false
        },
        {
          "key": "window_id",
          "label": "Window ID (defaults to the active window)",
          "field_type": "string",
          "required": false
        }
      ]
    }
  },
  "provides": {
    "collections": {
      "plugin.windows.snap_mode": {
        "preset": "tag",
        "writers": "platform_only",
        "merge": "collect",
        "fields": [],
        "lifecycle": {
          "type": "clear_on_event",
          "events": [
            "_platform.input.session_boundary"
          ]
        },
        "clear_on_unrelated_command": true,
        "exclusive": true,
        "feeds_matching": {
          "type": "as_gates",
          "scoped": true
        },
        "description": "Snap mode \u2014 direction words snap windows without repeating 'snap'."
      },
      "plugin.windows.desk_mode": {
        "preset": "tag",
        "writers": "platform_only",
        "merge": "collect",
        "fields": [],
        "lifecycle": {
          "type": "clear_on_event",
          "events": [
            "_platform.input.session_boundary"
          ]
        },
        "clear_on_unrelated_command": true,
        "exclusive": true,
        "feeds_matching": {
          "type": "as_gates",
          "scoped": true
        },
        "description": "Desk mode \u2014 number words switch desktops without repeating 'desk'."
      }
    },
    "events": {
      "windows.snapped": {
        "description": "A window was snapped, sent BEFORE it moves. Data: window_id, position (as asked: left, right, maximize, center, next, prev, …) and frame {x, y, w, h}. A plugin managing window placement (a tiler) should let go of the window."
      },
      "windows.moved_to_space": {
        "description": "A window is being sent to another desktop, sent BEFORE it moves. Data: window_id, space (1-based desktop number) and stay (whether the user stays on the current desktop)."
      }
    }
  },
  "consumes": {
    "collections": [
      "number"
    ]
  },
  "implements": {
    "on_action": true,
    "settings_tabs": [
      {
        "label": "Commands",
        "key": "commands"
      }
    ],
    "render_settings": true
  }
}