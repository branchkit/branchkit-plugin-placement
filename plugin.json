{
  "$schema": "https://branchkit.dev/schemas/manifest.json",
  "id": "placement",
  "name": "Placement",
  "icon": "grid",
  "requires": {
    "privileges": [
      "windows",
      "input",
      "display"
    ],
    "capabilities": {
      "uses": [
        "native.batch_set_frames",
        "native.cursor_info",
        "native.focused_window_id",
        "native.list_spaces",
        "native.move_window_to_space",
        "native.raise_window",
        "native.switch_space",
        "native.warp_cursor",
        "native.window_bounds",
        "native.world_model"
      ]
    }
  },
  "version": "1.0.0",
  "min_api_version": "0.2.0",
  "description": "Put any window where you want it — a position, a screen, a desktop — without a pointer. One-shot moves using each OS's own window model; no tiling engine.",
  "author": "BranchKit",
  "publisher": "github:branchkit",
  "dev": {
    "build": [
      [
        "go",
        "build",
        "-ldflags=-s -w",
        "-o",
        "../placement-plugin",
        "."
      ]
    ],
    "build_dir": "src"
  },
  "run": "./placement-plugin",
  "collection_data": {
    "voice_commands": "commands.json"
  },
  "action_prefix": "placement",
  "action_types": {
    "cycle_window": {
      "uses": [
        "native.raise_window"
      ],
      "label": "Next Window of This App",
      "consequence": "reversible",
      "fields": []
    },
    "undo": {
      "label": "Put Window Back",
      "consequence": "reversible",
      "fields": []
    },
    "overview": {
      "label": "Show All Windows",
      "fields": []
    },
    "desk_switch": {
      "uses": [
        "native.switch_space"
      ],
      "label": "Switch Desktop",
      "consequence": "reversible",
      "fields": [
        {
          "key": "space",
          "label": "Space Number",
          "placeholder": "1",
          "field_type": "string",
          "required": true
        }
      ]
    },
    "snap": {
      "label": "Snap Window",
      "consequence": "reversible",
      "fields": [
        {
          "key": "position",
          "label": "Position",
          "field_type": "enum",
          "enum_values": [
            "left",
            "right",
            "top",
            "bottom",
            "maximize",
            "almost_maximize",
            "center",
            "left_third",
            "center_third",
            "right_third",
            "left_two_thirds",
            "right_two_thirds",
            "top_left",
            "top_right",
            "bottom_left",
            "bottom_right",
            "next",
            "prev"
          ],
          "required": false
        },
        {
          "key": "app",
          "label": "App (defaults to the focused window)",
          "field_type": "string",
          "required": false
        }
      ]
    },
    "move_to_space": {
      "uses": [
        "native.move_window_to_space",
        "native.switch_space"
      ],
      "label": "Move Window to Space",
      "fields": [
        {
          "key": "space",
          "label": "Space Number",
          "placeholder": "1",
          "field_type": "string",
          "required": true
        },
        {
          "key": "stay",
          "label": "Stay on Current Space",
          "field_type": "boolean",
          "required": false
        },
        {
          "key": "window_id",
          "label": "Window ID (defaults to the active window)",
          "field_type": "string",
          "required": false
        },
        {
          "key": "app",
          "label": "App (defaults to the focused window)",
          "field_type": "string",
          "required": false
        }
      ]
    }
  },
  "provides": {
    "collections": {
      "plugin.placement.snap_mode": {
        "preset": "tag",
        "writers": "platform_only",
        "merge": "collect",
        "fields": [],
        "lifecycle": {
          "type": "clear_on_event",
          "events": [
            "_platform.input.session_boundary"
          ]
        },
        "clear_on_unrelated_command": true,
        "exclusive": true,
        "feeds_matching": {
          "type": "as_gates",
          "scoped": true
        },
        "description": "Snap mode — direction words snap windows without repeating 'snap'."
      },
      "plugin.placement.desk_mode": {
        "preset": "tag",
        "writers": "platform_only",
        "merge": "collect",
        "fields": [],
        "lifecycle": {
          "type": "clear_on_event",
          "events": [
            "_platform.input.session_boundary"
          ]
        },
        "clear_on_unrelated_command": true,
        "exclusive": true,
        "feeds_matching": {
          "type": "as_gates",
          "scoped": true
        },
        "description": "Desk mode — number words switch desktops without repeating 'desk'."
      }
    },
    "events": {
      "placement.snapped": {
        "description": "A window was snapped, sent BEFORE it moves. Data: window_id, position (as asked: left, right, maximize, center, next, prev, …) and frame {x, y, w, h}. A plugin managing window placement (a tiler) should let go of the window."
      },
      "placement.moved_to_space": {
        "description": "A window is being sent to another desktop, sent BEFORE it moves. Data: window_id, space (1-based desktop number) and stay (whether the user stays on the current desktop)."
      }
    }
  },
  "consumes": {
    "collections": [
      "number",
      "apps"
    ]
  },
  "implements": {
    "on_action": true
  }
}
